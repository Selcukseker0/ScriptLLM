# LLM (araştırma, senaryo ve fact-check aşamaları için zorunlu)
# OpenAI-uyumlu API. LLM_API_KEY yerine OPENAI_API_KEY de kullanılabilir.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Yerel Ollama kullanımı: OpenAI API anahtarı gerektirmez.
# Önce Ollama'yı ve seçilen modeli yerelde çalıştırın; kullanım donanımınıza bağlıdır.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Web arama (isteğe bağlı; anahtar yoksa sınırlı Wikipedia API'si kullanılır)
# Birden fazla anahtar varsa öncelik TAVILY'dedir; isterseniz SEARCH_PROVIDER ile seçin.
TAVILY_API_KEY=
BRAVE_API_KEY=
# SEARCH_PROVIDER=tavily | brave | wikipedia | none

# Yerel ayarlar
PORT=5174
# DATA_DIR=./data
